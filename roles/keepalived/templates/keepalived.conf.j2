vrrp_script check_haproxy {
  script "pkill -0 haproxy"
  interval 2
  weight 2
}
vrrp_instance VI_1 {
  state {% if patroni_role == 'master' %}MASTER{% else %}BACKUP{% endif %}

  interface {{ network_interface }}
  virtual_router_id 51
  priority {% if patroni_role == 'master' %}101{% else %}100{% endif %}

  advert_int 1
  virtual_ipaddress {
    {{ virtual_ip }}
  }
  track_script {
    check_haproxy
  }
}
